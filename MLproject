name: wind-power-orkney

python_env: python_env.yaml

entry_points:
  main:
    parameters:
      power_csv: {type: string, default: "data/power.csv"}
      weather_csv: {type: string, default: "data/weather.csv"}
    command: >
      python train.py
      --power-csv {power_csv}
      --weather-csv {weather_csv}

